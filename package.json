{
  "name": "pocket-rivals",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:browser": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:debug": "npm run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "npm run android:sync && cd android && ./gradlew bundleRelease",
    "test:modules": "node scripts/check-module.mjs",
    "format": "prettier --write \"src/**/*.{ts,css,svg}\" \"tests/**/*.ts\" \"scripts/*.{ts,mjs}\" \"examples/**/*.{ts,svg}\" \"*.{ts,json,md}\" \"docs/*.md\"",
    "test:bundle": "node scripts/bundle-report.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@fontsource/fredoka": "^5.2.0",
    "@fontsource/nunito-sans": "^5.2.0",
    "katex": "^0.19.0",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@playwright/test": "^1.55.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.21.1"
  }
}
